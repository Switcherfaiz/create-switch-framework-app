{
  "directories": {
    "output": "dist"
  },
  "extraMetadata": {
    "main": "main.js"
  },
  "files": [
    "main.js",
    "preload.js",
    "server.js",
    "package.json",
    "constants/**/*",
    "electron/**/*",
    "server/**/*",
    "routes/**/*",
    "components/**/*",
    "app/**/*",
    "assets/**/*",
    "hooks/**/*",
    "index.html",
    "index.js",
    "!dist/**",
    "!.env",
    "!.git/**"
  ],
  "asar": true,
  "win": { "target": "nsis" },
  "mac": { "target": "dmg" },
  "linux": { "target": "AppImage" },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true
  }
}
